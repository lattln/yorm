{
  "name": "@yorm/core",
  "version": "0.1.0",
  "description": "Deterministic object\u2192rows projection engine for YORM: the mapping DSL, projection planner, provenance tags, and store contracts. Zero runtime dependencies.",
  "keywords": [
    "yorm",
    "orm",
    "projection",
    "mapping",
    "crdt"
  ],
  "license": "MIT",
  "author": "Medical Informatics Engineering, Inc.",
  "homepage": "https://github.com/mieweb/yorm/tree/main/packages/core#readme",
  "bugs": "https://github.com/mieweb/yorm/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mieweb/yorm.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests --root ../.. packages/core"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
